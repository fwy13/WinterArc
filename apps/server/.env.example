PORT=2567
NODE_ENV=development
# Exact FRONTEND origins; add your PC LAN IP for HTTP UI/API testing, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:2567,http://192.168.1.10:5173
# Google login requires localhost (ADB reverse) or a valid HTTPS domain, not LAN HTTP.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:2567
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Separate administrator credentials. No default password. Google sub no longer grants admin.
ADMIN_USERNAME=
# Generate with npm run admin:hash -w @winterarc/server, then paste the single-quoted hash.
ADMIN_PASSWORD_HASH=
# Relative to server working directory; use an absolute persistent path in production.
ACCOUNT_DB_PATH=./data/accounts.sqlite
