HTTP_PORT=80
HTTPS_PORT=443
# Exact frontend origins, comma-separated, no path/trailing slash. Not the backend URL.
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app,http://localhost:5173
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
ADMIN_USERNAME=admin
# Single quotes keep bcrypt dollar signs literal in Compose's .env parser.
# Generate your own hash, then replace the empty string below.
ADMIN_PASSWORD_HASH=''
# lax for same-site play.example.com + api.example.com.
# none only for HTTPS cross-site deployments; browser cookie restrictions still apply.
COOKIE_SAME_SITE=lax
